# Ignore everything at the root level (instance/, localhost/, venv/, etc.)
/*

# Keep essential files for the application
!.gitignore
!flask_app.py
!flask_app_v2.py
!requirements.txt
!VERSION
!push.sh
!CLAUDE.md
!conftest.py
!pytest.ini
!flask_test.cfg

# Keep source code and tests
# localhost/ has its own separate git repo/history and stays ignored here.
!/ltv_app/
!/migrations/

# Keep Claude Code skills only (not worktrees, venvs, or local settings)
!/.claude/
/.claude/*
!/.claude/skills/

# Keep design specs (no client data belongs here — see BUGS.md for that,
# which stays out of this public repo on purpose)
!/docs/
/docs/*
!/docs/superpowers/

# Keep Excel templates needed by the application.
# Order matters: re-include the instance/ directory, exclude everything inside
# it, then whitelist only what the app needs.
!/instance/
/instance/*
!/instance/excel_templates/
!/instance/excel_templates/*.xlsx
!/instance/gmail_setup.py

# Compiled Python — never commit these
__pycache__/
*.pyc
*.pyo
*.pyd

# Databases — never commit these. THIS REPO IS PUBLIC.
# Previously the live 8.9 MB "LTV Stocks.db" was kept out by the /instance/*
# rule alone. These rules are belt and braces: they hold wherever it is moved.
*.db
*.db.bak-*
*.sqlite
*.sqlite3

# Gmail OAuth credentials — never commit these
instance/gmail_token.json
instance/gmail_client_secret.json
gmail_token.json
gmail_client_secret.json
